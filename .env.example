# ==============================================================================
# SkyFare India - Production & Local Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Managed PostgreSQL Cloud Database (Production)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string (Transaction Pooler port 6543 or Session port 5432)
# Example: postgresql://postgres.xxxx:your_db_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API project credentials (found under Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. Automated Ingestion & Scrapling Stealth Engine Configuration
# ------------------------------------------------------------------------------
# Scraping engine mode: 'dual' (SerpApi + Scrapling), 'scrapling' (100% free), or 'serpapi'
SKYFARE_INGESTION_ENGINE=dual
SCRAPLING_ENGINE_ENABLED=true
SKYFARE_BATCH_DELAY_SECONDS=1.5
SKYFARE_LIVE_QUOTE_LIMIT=30

# ------------------------------------------------------------------------------
# 3. SerpApi Fallback Keys (Optional when transitioning to 100% Scrapling)
# ------------------------------------------------------------------------------
SERPAPI_API_KEY=your_serpapi_key_here
SERPAPI_TEST_KEY=your_test_key_here
SERPAPI_CHECKUP_KEY=your_test_key_here

# Dedicated Corridor Teammate Keys (DEL-BOM, BOM-DEL, DEL-BLR, etc.)
SERPAPI_KEY_DEL_BOM=key_from_teammate_1
SERPAPI_KEY_BOM_DEL=key_from_teammate_2
SERPAPI_KEY_DEL_BLR=key_from_teammate_3
SERPAPI_KEY_BLR_DEL=key_from_teammate_4
SERPAPI_KEY_DEL_CCU=key_from_teammate_5
SERPAPI_KEY_CCU_DEL=key_from_teammate_6
SERPAPI_KEY_BOM_BLR=key_from_teammate_7
SERPAPI_KEY_BLR_BOM=key_from_teammate_8
SERPAPI_KEY_DEL_HYD=key_from_teammate_9
SERPAPI_KEY_HYD_DEL=key_from_teammate_10
SERPAPI_KEY_MAA_DEL=key_from_teammate_11
SERPAPI_KEY_DEL_MAA=key_from_teammate_12
SERPAPI_KEY_CCU_BOM=key_from_teammate_13
SERPAPI_KEY_BOM_GOI=key_from_teammate_14

# Aggregated Comma-Separated Key Pool
SERPAPI_API_KEYS=key1,key2,key3,key4

# ------------------------------------------------------------------------------
# 4. Security & Administration
# ------------------------------------------------------------------------------
# Official MoSPI Officer session authentication token (for admin endpoints)
SKYFARE_ADMIN_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
